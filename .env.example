# Copy this file to server/dart_frog_api/.env and fill in real values.
# NEVER commit the real .env file. NEVER put real secrets in this file.

APP_NAME=SanskritAI Translator
APP_ENV=development
PORT=8080

# --- MongoDB Atlas ---
MONGODB_URI=<YOUR_MONGODB_URI>
MONGODB_DATABASE=sanskrit_translator

# --- Auth ---
JWT_SECRET=<YOUR_JWT_SECRET>
JWT_ACCESS_TOKEN_TTL_MINUTES=15
JWT_REFRESH_TOKEN_TTL_DAYS=30

# --- LLM provider ---
# Supported today: openai. Add new providers via LLMProvider interface
# (see server/dart_frog_api/lib/src/llm/llm_provider.dart) without touching callers.
LLM_PROVIDER=openai
OPENAI_API_KEY=<YOUR_OPENAI_API_KEY>
OPENAI_MODEL=<YOUR_OPENAI_MODEL>
OPENAI_ECONOMY_MODEL=<YOUR_OPENAI_ECONOMY_MODEL>
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Embeddings / vector retrieval ---
EMBEDDING_MODEL=<YOUR_EMBEDDING_MODEL>
VECTOR_INDEX_NAME=<YOUR_VECTOR_INDEX_NAME>

# --- Caching / rate limiting ---
REDIS_URL=<YOUR_REDIS_URL>

# --- CORS ---
# Comma-separated list of allowed origins, e.g. https://app.example.com,http://localhost:3000
CORS_ORIGINS=<YOUR_ALLOWED_ORIGINS>

# --- Limits ---
MAX_INPUT_CHARACTERS=2000
LLM_REQUEST_TIMEOUT_SECONDS=30
LLM_MAX_OUTPUT_TOKENS=2000
