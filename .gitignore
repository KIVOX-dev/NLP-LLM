# Dataset JSONL files are generated by scripts/generate_dataset.dart — keep
# the directory structure versioned, but not large generated payloads unless
# you've deliberately decided to check in a dataset snapshot.
dataset/**/*.jsonl

# Raw Kaggle pulls — re-fetchable, and train.txt (600MB+) exceeds GitHub's
# 100MB per-file limit.
_kaggle_pull/sanskrit/train.txt
